{
  "name": "tic-frontend",
  "version": "2.0.0",
  "private": true,
  "description": "Site de The Infinite Corridor Software Solutions (TIC) — frontend React",
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && node scripts/postbuild.mjs",
    "preview": "vite preview --outDir build/client",
    "typecheck": "react-router typegen && tsc",
    "check:links": "node scripts/check-links.mjs build/client",
    "media": "node scripts/optimize-media.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@react-router/node": "7.18.4",
    "isbot": "5.1.28",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@react-router/dev": "7.18.4",
    "@types/node": "22.18.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
