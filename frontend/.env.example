# URL de l'API Django (sans « / » final).
#  - vide            : les formulaires sont envoyés à Netlify Forms (mode actuel, sans backend)
#  - /api            : même domaine (Django derrière un proxy / redirection Netlify)
#  - https://api.tic-solutions.com : domaine séparé (CORS à autoriser côté Django)
VITE_API_URL=

# Domaine public du site (balises canonical, Open Graph, sitemap)
VITE_SITE_URL=https://tic-infinit.netlify.app

# En développement : où tourne Django (proxy Vite pour /api)
VITE_API_PROXY=http://localhost:8000
